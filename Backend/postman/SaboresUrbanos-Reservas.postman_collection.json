                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const { reserva } = pm.response.json();",
                  "pm.environment.set('reservaId', reserva._id);",
                  "",
                  "pm.test('Calcula fin = 14:30 y estado confirmada', function () {",
                  "  pm.expect(reserva.fin).to.eql('14:30');",
                  "  pm.expect(reserva.estado).to.eql('confirmada');",
                  "  pm.expect(reserva.mesa).to.eql('T-01');",
                  "});"
