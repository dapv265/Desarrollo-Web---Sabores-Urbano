          "name": "Filtrar por fecha 2026-11-12",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Todas las reservas son del 2026-11-12', function () {",
                  "  const { reservas } = pm.response.json();",
                  "  pm.expect(reservas.length).to.be.above(0);",
