              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Es un arreglo con los campos que usan Pedidos y Precios', function () {",
                  "  const productos = pm.response.json();",
                  "  pm.expect(productos).to.be.an('array').and.not.empty;",
                  "  productos.forEach(function (p) {",
                  "    pm.expect(p).to.include.keys('id', 'nombre', 'precio', 'categoriaId', 'disponible', 'historialPrecios');",
                  "    pm.expect(p.id).to.be.a('number');",
                  "  });",
                  "});"
